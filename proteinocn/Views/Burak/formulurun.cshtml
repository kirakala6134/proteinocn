@using proteinocn.Models;
@{
    ViewBag.Title = "formulurun";
    Layout = "~/sablon.cshtml";
}

<div style="display: flex;justify-content: center;">
    <h1 style="font-size: 40px;font-weight: 800;margin: 15px 0px;">FORMÜL ÜRÜNLER</h1>
</div>
<div id="proteinler">
    @foreach (var a in Model)
    {
        <div class="proteinlerurun" style="margin-bottom:50px">
            <a href="~/Burak/urunozel?gonderilenid=@a.urun_id">
                <div><img src="~/img/@a.urun_foto1" alt=""></div>
                <div style="height:25px"><h3>@a.urun_ad</h3></div>
                <div style="height:20px"><p>@a.urun_aciklama1</p></div>
                <div class="fiyat"><b>@string.Format("{0:c}", a.urun_fiyat)</b></div>
            </a>
            <div style="text-align:center"> <a href="~/Burak/sepeteekle?id=@a.urun_id"><button style="background-color: #16a0dd; border: none; padding: 10px; border-radius: 2px; font-size: 14px;cursor:pointer"><i style="margin-right:4px" class="fa fa-shopping-cart"></i>Sepete Ekle</button></a> </div>
        </div>
    }
</div>