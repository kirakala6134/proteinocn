
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>admingiris</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/css2/stil.css" rel="stylesheet" />
</head>
<body>
    <div>
        <div id="girisyap">
            <form method="post">
                <div>
                    <p>@ViewBag.adminHata</p>
                    <p>@ViewBag.mesajd</p>
                </div>
                <label for="kad">*Admin Adı</label>
                <input type="text" name="admin_kullanici_adi" id="kad" required>
                <label for="sfr">*Şifre</label>
                <input type="password" name="admin_kullanici_sifre" id="sfr" required>
                <p><a style="color: black;" href="">Şifremi Unuttum?</a></p>
                <input type="submit" value="GİRİŞ YAP">
            </form>
        </div>
    </div>
</body>
</html>
